# Clawflare Environment Variables
# Copy this file to .env and fill in your values

# Required: Cloudflare API Token (get from https://dash.cloudflare.com/profile/api-tokens)
# Use "Edit zone D1", "Edit workers", "Edit KV namespaces" permissions
CF_API_TOKEN=your-cloudflare-api-token-here

# Required: AWS Bearer Token for Bedrock (get from AWS Console or IAM)
# This is used for the default amazon-bedrock provider with minimax.minimax-m2.5 model
AWS_BEARER_TOKEN_BEDROCK=your-aws-bearer-token-here

# Optional: AI Provider and Model (defaults: amazon-bedrock, minimax.minimax-m2.5)
# Other providers: cloudflare-workers-ai, anthropic, openai, etc.
# See pi-ai package for available models
# AI_PROVIDER=amazon-bedrock
# AI_MODEL=minimax.minimax-m2.5

# Optional: AWS Region for Bedrock (default: us-east-1)
# AWS_REGION=us-east-1

# Optional: AWS Profile for Bedrock (alternative to bearer token)
# AWS_PROFILE=default

# Optional: Custom worker name (default: clawflare-harness)
# CF_WORKER_NAME=clawflare-harness

# Optional: Account ID (usually auto-detected from API token)
# CF_ACCOUNT_ID=your-account-id

# Optional: Enable mock AI for testing (default: false in production)
# MOCK_AI=true

# ==========================================
# CLI Configuration
# ==========================================

# Required: API token for CLI authentication (must match harness API_TOKEN secret)
# Set this in harness via: wrangler secret put API_TOKEN
CLAWFLARE_API_TOKEN=your-clawflare-api-token-here

# Optional: Clawflare harness URL (default: http://localhost:8787 for local dev)
# For production: https://your-worker.your-subdomain.workers.dev
# CLAWFLARE_URL=http://localhost:8787
