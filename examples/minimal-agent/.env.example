# Cloudflare API token (for deployment)
CLOUDFLARE_API_TOKEN=your-token

# Clawflare API token (for client authentication)
CLAWFLARE_API_TOKEN=your-secret-token

# AI Provider (optional - defaults to bedrock)
# AI_PROVIDER=bedrock
# AI_MODEL=minimax.minimax-m2.5

# AWS Bedrock credentials (if using bedrock)
AWS_BEARER_TOKEN_BEDROCK=your-aws-bearer-token
AWS_REGION=us-east-1

# Or Anthropic (if using anthropic)
# ANTHROPIC_API_KEY=your-anthropic-key

# Or OpenAI (if using openai)
# OPENAI_API_KEY=your-openai-key
