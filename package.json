{
  "name": "clawflare",
  "version": "0.1.0",
  "private": true,
  "description": "Openclaw natively built for Cloudflare - AI agents that deploy and manage Cloudflare resources",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "deploy": "cd packages/harness && pnpm run deploy",
    "deploy:prod": "pnpm deploy",
    "dev": "cd packages/harness && npx wrangler dev src/index.ts",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r --filter=!@clawflare/e2e test",
    "test:e2e": "cd packages/e2e && node --import=tsx src/index.ts",
    "test:e2e:ui": "cd packages/e2e && node --import=tsx src/index.ts --ui",
    "lint": "pnpm -r lint",
    "cli": "cd packages/cli && node --import=tsx src/index.ts",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.95.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
