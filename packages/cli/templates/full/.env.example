# GitHub API Token (optional, for enhanced GitHub API access)
GITHUB_TOKEN=your_github_token_here

# Cloudflare API Token (optional, for Cloudflare API access)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# AI Provider Configuration
AI_PROVIDER={{AI_PROVIDER}}
AI_MODEL={{AI_MODEL}}

# AWS credentials for Bedrock (if using amazon-bedrock)
AWS_BEARER_TOKEN_BEDROCK=your_aws_bearer_token
AWS_REGION=us-east-1

# Add your custom secrets here
# STRIPE_API_KEY=your_stripe_key_here
