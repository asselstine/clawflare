{
  "name": "@clawflare/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end tests for Clawflare using local Wrangler infrastructure",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import=tsx src/index.ts",
    "test:remote": "node --import=tsx src/index.ts --remote",
    "test:cloudflare": "vitest run test/cloudflare-egress.test.ts",
    "deploy": "cd ../runtime && npx wrangler deploy",
    "deploy:test": "cd ../runtime && npx wrangler deploy --config wrangler.test.jsonc",
    "dev:test": "cd ../runtime && npx wrangler dev --config wrangler.test.jsonc",
    "clean": "rm -f src/index.js tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "clawflare": "workspace:*",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.90.1"
  }
}
