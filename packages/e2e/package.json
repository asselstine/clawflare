{
  "name": "@clawflare/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end tests for Clawflare - deploys worker and tests via TUI",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import=tsx src/index.ts",
    "test:cloudflare": "vitest run test/cloudflare-egress.test.ts",
    "deploy": "cd ../harness && npx wrangler deploy",
    "deploy:test": "cd ../harness && npx wrangler deploy --config wrangler.test.jsonc",
    "dev:test": "cd ../harness && npx wrangler dev --config wrangler.test.jsonc",
    "clean": "rm -f src/index.js tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@clawflare/cli": "workspace:*",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "vitest": "^3.0.0",
    "wrangler": "^3.95.0"
  }
}
