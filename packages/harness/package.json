{
  "name": "@clawflare/harness",
  "version": "0.1.0",
  "private": true,
  "description": "Clawflare Agent harness - runs in Cloudflare Workers with pi-agent-core",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:raw": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "build": "tsc --build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clawflare/cloudflare": "workspace:*",
    "@clawflare/egress-core": "workspace:*",
    "@clawflare/github": "workspace:*",
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.90.1"
  }
}
