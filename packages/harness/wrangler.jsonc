// wrangler.jsonc - Clawflare Harness Configuration
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clawflare-harness",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",

  // Build configuration - let Wrangler bundle with esbuild defaults
  "minify": true,
  "define": {
    "process.env.NODE_ENV": "\"production\"",
    "__DEV__": "false"
  },

  // Worker Loader for Dynamic Worker execution
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],

  // SQLite Durable Object for centralized storage
  "durable_objects": {
    "bindings": [
      {
        "name": "DATASTORE",
        "class_name": "ClawflareDatastore"
      }
    ]
  },

  // Migrations for Durable Objects
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ClawflareDatastore"]
    }
  ],

  // Local dev KV namespaces - these are auto-created in wrangler dev
  // For production, create real namespaces and update the IDs
  "kv_namespaces": [
    {
      "binding": "AGENT_STATE",
      "id": "fd296c5aa01d4d1ba4a5613438466bee"
    }
  ],

  // Environment variables (set via wrangler secret put or --var flag)
  "vars": {
    "AI_PROVIDER": "amazon-bedrock",
    "AI_MODEL": "minimax.minimax-m2.5"
    // Bearer token for Bedrock (set via `wrangler secret put AWS_BEARER_TOKEN_BEDROCK`)
    // "AWS_BEARER_TOKEN_BEDROCK": ""
  }
}
