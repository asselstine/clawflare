// wrangler.jsonc - Clawflare Harness Configuration
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clawflare-harness",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",

  // Build configuration - let Wrangler bundle with esbuild defaults
  "minify": true,
  "define": {
    "process.env.NODE_ENV": "\"production\"",
    "__DEV__": "false"
  },

  // Service binding to the HttpGateway entrypoint for Dynamic Worker egress
  "services": [
    {
      "binding": "HTTP_GATEWAY",
      "service": "clawflare-harness",
      "entrypoint": "HttpGateway"
    }
  ],

  // Worker Loader for Dynamic Worker execution
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],

  // D1 Database - Primary persistent storage for sessions, events, and code
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clawflare",
      "database_id": "<database-id>",
      "preview_database_id": "<preview-database-id>",
      "migrations_dir": "migrations"
    }
  ],

  // Durable Objects - WebSocket coordination only
  // Session state and stored data are now in D1
  "durable_objects": {
    "bindings": [
      {
        "name": "WEBSOCKET_SESSION",
        "class_name": "ClawflareWebSocketSession"
      },
      {
        "name": "SESSION_STORE",
        "class_name": "ClawflareSessionStore"
      }
    ]
  },

  // Migrations for Durable Objects
  "migrations": [
    {
      "tag": "v1",
      "deleted_classes": ["ClawflareDatastore"]
    },
    {
      "tag": "v2",
      "new_classes": ["ClawflareWebSocketSession"]
    },
    {
      "tag": "v3",
      "new_classes": ["ClawflareSessionStore"]
    }
  ],

  // Workflow for durable agent execution - PERSISTENT per-session workflow
  "workflows": [
    {
      "name": "clawflare-agent-workflow",
      "binding": "AGENT_WORKFLOW",
      "class_name": "PersistentSessionWorkflow"
    }
  ],

  // Environment variables (set via wrangler secret put or --var flag)
  "vars": {
    "AI_PROVIDER": "amazon-bedrock",
    "AI_MODEL": "minimax.minimax-m2.5"
    // Bearer token for Bedrock (set via `wrangler secret put AWS_BEARER_TOKEN_BEDROCK`)
    // "AWS_BEARER_TOKEN_BEDROCK": ""
  }
}
