// wrangler.template.jsonc - Template for generating wrangler.jsonc
// DO NOT EDIT wrangler.jsonc directly - edit this file and run `pnpm generate:config`
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clawflare-harness",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat", "enable_ctx_exports"],
  "main": "src/index.ts",

  "minify": true,
  "define": {
    "process.env.NODE_ENV": "\"production\"",
    "__DEV__": "false"
  },

  "services": [
    {
      "binding": "HTTP_GATEWAY",
      "service": "clawflare-harness",
      "entrypoint": "HttpGateway"
    }
  ],

  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],

  "containers": [
    {
      "class_name": "CodingContainer",
      "image": "./container-runtime/Dockerfile",
      "max_instances": 10,
      "instance_type": "lite"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clawflare",
      "database_id": "{{DATABASE_ID}}",
      "preview_database_id": "{{PREVIEW_DATABASE_ID}}",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "WEBSOCKET_SESSION",
        "class_name": "ClawflareWebSocketSession"
      },
      {
        "name": "CODING_CONTAINER",
        "class_name": "CodingContainer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ClawflareDatastore"]
    },
    {
      "tag": "v2",
      "new_classes": ["ClawflareWebSocketSession"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["ClawflareDatastore"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["CodingContainer"]
    }
  ],

  "workflows": [
    {
      "name": "clawflare-agent-workflow",
      "binding": "AGENT_WORKFLOW",
      "class_name": "PersistentSessionWorkflow"
    }
  ],

  "vars": {
    "AI_PROVIDER": "{{AI_PROVIDER}}",
    "AI_MODEL": "{{AI_MODEL}}"
  }
}
