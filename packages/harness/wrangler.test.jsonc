// wrangler.test.jsonc - Clawflare Harness test-only configuration
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clawflare-harness-test",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/test-index.ts",

  "minify": false,
  "define": {
    "process.env.NODE_ENV": "\"test\"",
    "__DEV__": "true"
  },

  "services": [
    {
      "binding": "HTTP_GATEWAY",
      "service": "clawflare-harness-test",
      "entrypoint": "HttpGateway"
    }
  ],

  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "DATASTORE",
        "class_name": "ClawflareDatastore"
      },
      {
        "name": "WEBSOCKET_SESSION",
        "class_name": "ClawflareWebSocketSession"
      },
      {
        "name": "SESSION_STORE",
        "class_name": "ClawflareSessionStore"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ClawflareDatastore"]
    },
    {
      "tag": "v2",
      "new_classes": ["ClawflareWebSocketSession"]
    },
    {
      "tag": "v3",
      "new_classes": ["ClawflareSessionStore"]
    }
  ],

  // Workflow for durable agent execution
  "workflows": [
    {
      "name": "clawflare-agent-workflow-test",
      "binding": "AGENT_WORKFLOW",
      "class_name": "Workflow"
    }
  ],

  "vars": {
    "AI_PROVIDER": "amazon-bedrock",
    "AI_MODEL": "minimax.minimax-m2.5"
  }
}
