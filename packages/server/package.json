{
  "name": "@clawflare/server",
  "version": "0.1.0",
  "private": true,
  "description": "Clawflare Server - runs in Cloudflare Workers with pi-agent-core",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:raw": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "timing:analyze": "node scripts/analyze-timing.mjs",
    "logs": "wrangler tail",
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrations:create": "wrangler d1 migrations create clawflare",
    "db:migrations:list": "wrangler d1 migrations list clawflare",
    "db:migrations:apply:local": "wrangler d1 migrations apply clawflare --local",
    "db:migrations:apply:remote": "wrangler d1 migrations apply clawflare --remote"
  },
  "dependencies": {
    "@clawflare/cloudflare": "workspace:*",
    "@clawflare/egress-core": "workspace:*",
    "@clawflare/github": "workspace:*",
    "@clawflare/types": "workspace:*",
    "@cloudflare/containers": "latest",
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "miniflare": "^4.20260508.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.90.1"
  }
}

