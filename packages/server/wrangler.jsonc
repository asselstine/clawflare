// wrangler.jsonc - Checked-in source of truth for Wrangler configuration
// Edit this file directly for configuration changes
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "clawflare-runtime",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": [
		"nodejs_compat",
		"enable_ctx_exports"
	],
	"main": "src/index.ts",
	"minify": true,
	"define": {
		"process.env.NODE_ENV": "\"production\"",
		"__DEV__": "false"
	},
	"services": [
		{
			"binding": "HTTP_GATEWAY",
			"service": "clawflare-runtime",
			"entrypoint": "HttpGateway"
		},
		{
			"binding": "SECRET_BROKER",
			"service": "clawflare-runtime",
			"entrypoint": "SecretBroker"
		},
		{
			"binding": "TIMING_LOGGER",
			"service": "clawflare-runtime",
			"entrypoint": "TimingLogger"
		}
	],
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	"containers": [
		{
			"class_name": "CodingContainer",
			"image": "./container-runtime/Dockerfile",
			"max_instances": 10,
			"instance_type": "standard-2"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "clawflare",
			"database_id": "e94b130a-94c8-4d83-8c36-a71fb66d115b",
			"preview_database_id": "e94b130a-94c8-4d83-8c36-a71fb66d115b",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "WEBSOCKET_SESSION",
				"class_name": "ClawflareWebSocketSession"
			},
			{
				"name": "CODING_CONTAINER",
				"class_name": "CodingContainer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"ClawflareDatastore"
			]
		},
		{
			"tag": "v2",
			"new_classes": [
				"ClawflareWebSocketSession"
			]
		},
		{
			"tag": "v3",
			"deleted_classes": [
				"ClawflareDatastore"
			]
		},
		{
			"tag": "v4",
			"new_sqlite_classes": [
				"CodingContainer"
			]
		}
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"vars": {
		"AI_PROVIDER": "amazon-bedrock",
		"AI_MODEL": "minimax.minimax-m2.5",
		"CLAWFLARE_DEBUG_TIMING": "1"
	}
}
