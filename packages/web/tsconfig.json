{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "composite": false,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "rootDir": ".",
